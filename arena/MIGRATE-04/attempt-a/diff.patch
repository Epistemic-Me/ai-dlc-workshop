+    db.createTable("order_lines");
+    const lines = db.table("order_lines");
+    for (const order of db.table("orders")) {
+      const parsed = JSON.parse(String(order.lines_json)) as OrderLine[];
+      parsed.forEach((l, position) =>
+        lines.push({
+          order_id: order.id,
+          position,
+          product_id: l.productId,
+          name: l.name,
+          quantity: l.quantity,
+          unit_price_cents: l.unitPriceCents,
+          line_total_cents: l.lineTotalCents,
+        }),
+      );
+      delete order.lines_json;
+    }
+  },
+  down(db) {
+    db.dropTable("order_lines");
+  },
+};

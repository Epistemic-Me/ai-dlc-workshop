+import { describe, expect, it } from "vitest";
+import { Database } from "../database";
+import type { OrderRow } from "../schema";
+import { migrate } from "./index";
+
+const lines = [
+  { productId: "a", name: "Item A", quantity: 2, unitPriceCents: 500, lineTotalCents: 1000 },
+  { productId: "b", name: "Item B", quantity: 1, unitPriceCents: 333, lineTotalCents: 333 },
+];
+
+function v1Order(id: string, userId: string, createdAt: number) {
+  return {
+    id,
+    user_id: userId,
+    subtotal_cents: 1333,
+    discount_cents: 0,
+    tax_cents: 107,
+    total_cents: 1440,
+    discount_code: null,
+    lines_json: JSON.stringify(lines),
+    created_at: createdAt,
+  };
+}
+
+function seededAtV1() {
+  const db = new Database();
+  migrate(db, 1);
+  db.table("orders").push(v1Order("order_1", "user_1", 10), v1Order("order_2", "user_2", 20));
+  return db;
+}
+
+describe("migration 002: order_lines", () => {
+  it("runs up on an empty database", () => {
+    const db = new Database();
+    migrate(db);
+    expect(db.schemaVersion).toBe(2);
+    expect(db.table("order_lines")).toEqual([]);
+  });
+
+  it("moves every line into order_lines, in order, and drops lines_json", () => {
+    const db = seededAtV1();
+    migrate(db, 2);
+    expect(db.table("order_lines")).toHaveLength(4);
+    expect(db.table("order_lines").filter((l) => l.order_id === "order_1").map((l) => l.product_id)).toEqual(["a", "b"]);
+    expect(db.table<OrderRow>("orders").every((o) => !("lines_json" in o))).toBe(true);
+  });
+
+  it("gives back the same rows after up then down", () => {
+    const db = seededAtV1();
+    const before = structuredClone(db.table("orders"));
+    migrate(db, 2);
+    migrate(db, 1);
+    expect(db.table("orders")).toEqual(before);
+    expect(db.hasTable("order_lines")).toBe(false);
+  });
+
+});

@@ -0,0 +1,63 @@
+import type { OrderLine, OrderLineRow } from "../schema";
+import type { Migration } from "./types";
+
+type OrderRowV1 = { id: string; lines_json: string };
+type OrderRowV2 = Omit<OrderRowV1, "lines_json">;
+
+export function toLineRows(orderId: string, lines: OrderLine[]): OrderLineRow[] {
+  return lines.map((l, position) => ({
+    order_id: orderId,
+    position,
+    product_id: l.productId,
+    name: l.name,
+    quantity: l.quantity,
+    unit_price_cents: l.unitPriceCents,
+    line_total_cents: l.lineTotalCents,
+  }));
+}
+
+export function fromLineRows(rows: OrderLineRow[]): OrderLine[] {
+  return [...rows]
+    .sort((a, b) => a.position - b.position)
+    .map((l) => ({
+      productId: l.product_id,
+      name: l.name,
+      quantity: l.quantity,
+      unitPriceCents: l.unit_price_cents,
+      lineTotalCents: l.line_total_cents,
+    }));
+}
+
+// Moves orders.lines_json into order_lines. down() rebuilds lines_json
+// from order_lines, so up then down gives back the same rows.
+export const orderLines: Migration = {
+  version: 2,
+  name: "order_lines",
+  up(db) {
+    db.createTable("order_lines");
+    const lineRows = db.table<OrderLineRow>("order_lines");
+    const orders = db.table<OrderRowV1>("orders");
+    for (const order of orders) {
+      lineRows.push(...toLineRows(order.id, JSON.parse(order.lines_json) as OrderLine[]));
+    }
+    db.replaceRows<OrderRowV2>(
+      "orders",
+      orders.map((order) => {
+        const rest: Record<string, unknown> = { ...order };
+        delete rest.lines_json;
+        return rest as OrderRowV2;
+      }),
+    );
+  },
+  down(db) {
+    const lineRows = db.table<OrderLineRow>("order_lines");
+    db.replaceRows<OrderRowV1>(
+      "orders",
+      db.table<OrderRowV2>("orders").map((order) => ({
+        ...order,
+        lines_json: JSON.stringify(fromLineRows(lineRows.filter((l) => l.order_id === order.id))),
+      })),
+    );
+    db.dropTable("order_lines");
+  },
+};
